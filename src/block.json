{
	"$schema": "https://json.schemastore.org/block.json",
	"apiVersion": 2,
	"attributes": {
		"price_records": {
			"type": "array",
			"selector": ".record-row",
			"query": {
				"name": {
					"type": "string",
					"default": ""
				},
				"price": {
					"type": "number",
					"source": "text",
					"selector": ".price",
					"default": 0
				},
				"index": {
					"type": "number",
					"default": null
				}
			},
			"default": []
		},
		"settings": {
			"type": "object",
			"default": {
				"delete": false,
				"add": true,
				"edit_description": true,
				"edit_price": true,
				"order_items": false
			}
		}
	},
	"example": {
		"attributes": {
			"price_records": [
					{
						"name": "Espresso",
						"price": 2.20,
						"index": 1
					},
					{
						"name": "Americano",
						"price": 2.50,
						"index": 2
					},
					{
						"name": "Latte",
						"price": 3.00,
						"index": 3
					},
					{
						"name": "Cappuccino",
						"price": 2.80,
						"index": 4
					},
					{
						"name": "Mocha",
						"price": 3.50,
						"index": 5
					},
					{
						"name": "Macchiato",
						"price": 2.70,
						"index": 6
					},
					{
						"name": "Flat White",
						"price": 3.20,
						"index": 7
					},
					{
						"name": "Iced Coffee",
						"price": 2.90,
						"index": 8
					},
					{
						"name": "Cold Brew",
						"price": 3.60,
						"index": 9
					},
					{
						"name": "Affogato",
						"price": 4.00,
						"index": 10
					}]
		}

	},
	"name": "price-list-block-zebra/price-list-block-zebra",
	"version": "1.2.0",
	"title": "Price List",
	"category": "text", 
	"icon": "editor-justify",
	"description": "Create a price list.",
	"supports": {
		"html": false
	},
	"textdomain": "price-list-block-zebra",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
